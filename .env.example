# Required: Telegram bot configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Required: Webhook configuration
WEBHOOK_HOST=ltgmc.online

# Required: Letta configuration
LETTA_PROJECT_ID=your_project_id_uuid
LETTA_API_KEY=your_letta_api_key

# Optional: Webhook path (default: empty string)
WEBHOOK_PATH=/bot

# Optional: Backend server configuration (defaults: 0.0.0.0:80)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=80

# Optional: For Gel cloud usage
GEL_INSTANCE=
GEL_SECRET_KEY=

# For self-hosted GelDB
GEL_HOST=gel
GEL_PORT=5656
GEL_PASSWORD=
# accept self signed cert for local network db
GEL_CLIENT_TLS_SECURITY=insecure

# Optional: Admin user IDs (comma-separated)
ADMIN_IDS=123456789,987654321

# Optional: Info notes directory (absolute path, defaults to <project_root>/notes)
# INFO_DIR=/absolute/path/to/notes

# Optional: Logging verbosity level (default: INFO)
# LOGGING_LEVEL=INFO

# Optional: Gemini API key for image generation
# GEMINI_API_KEY=your_gemini_api_key

# Optional: BFL API key for FLUX image generation
# BFL_API_KEY=your_bfl_api_key

# Optional: OpenAI API key. Enables voice transcription (Whisper) and the
# gpt-image-* models of the image generation tool. Without it and without
# ELEVENLABS_API_KEY the bot cannot handle voice at all.
# OPENAI_API_KEY=your_openai_api_key
# WHISPER_MODEL=gpt-4o-mini-transcribe

# Optional: ElevenLabs API key. Preferred over Whisper when both are set:
# 100MB limit and automatic language detection.
# ELEVENLABS_API_KEY=your_elevenlabs_api_key
# ELEVENLABS_STT_MODEL=scribe_v2

# Optional: send a message to ADMIN_IDS when a handler raises (default: false)
# NOTIFY_ADMINS_ON_ERROR=true
